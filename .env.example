SUPABASE_SERVICE_ROLE_KEY="sb_publishable_RKpvZxalRa8lcaW9w6ySbw_oCjdJnuI"

# Client-side (frontend) — prefixed with VITE_
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
