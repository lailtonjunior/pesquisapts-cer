# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Vercel Environment Variables (server-side only).
# Do NOT prefix with VITE_ — this key must stay on the server.
GEMINI_API_KEY="your-gemini-api-key"

# SUPABASE: Required for data persistence.
# Server-side (API routes) — do NOT prefix with VITE_
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Client-side (frontend) — prefixed with VITE_
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
